{
  "name": "@gutenberg/shared",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @gutenberg/db run build",
    "build": "tsc -p tsconfig.json",
    "format": "eslint . --fix --ignore-pattern 'dist/**' --ignore-pattern '*.json' && prettier --write .",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@gutenberg/db": "workspace:*",
    "@nestjs/common": "^11.1.19",
    "drizzle-orm": "^0.45.2",
    "reflect-metadata": "^0.2.2"
  }
}
