{
  "name": "gutenberg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gutenberg-sh/gutenberg.git"
  },
  "homepage": "https://github.com/gutenberg-sh/gutenberg#readme",
  "bugs": {
    "url": "https://github.com/gutenberg-sh/gutenberg/issues"
  },
  "packageManager": "pnpm@10.33.1",
  "type": "module",
  "engines": {
    "node": "22.22.2",
    "pnpm": "10.33.1"
  },
  "scripts": {
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down --remove-orphans",
    "stack:reset": "docker compose down -v --remove-orphans",
    "solana:build": "pnpm --filter @gutenberg/solana run anchor:build",
    "solana:deploy": "pnpm --filter @gutenberg/solana run anchor:deploy",
    "solana:test": "pnpm --filter @gutenberg/solana run anchor:test",
    "core:build": "pnpm --filter @gutenberg/core run build",
    "db:build": "pnpm --filter @gutenberg/db run build",
    "shared:build": "pnpm --filter @gutenberg/shared run build",
    "db:migrate": "pnpm --filter @gutenberg/db run db:migrate",
    "db:apply": "pnpm --filter @gutenberg/db run db:apply",
    "gateway:dev": "pnpm --filter @gutenberg/gateway run dev",
    "gateway:build": "pnpm --filter @gutenberg/gateway run build",
    "api:dev": "pnpm --filter @gutenberg/api run dev",
    "api:build": "pnpm --filter @gutenberg/api run build",
    "indexer:dev": "pnpm --filter @gutenberg/indexer run dev",
    "indexer:build": "pnpm --filter @gutenberg/indexer run build",
    "format": "pnpm --filter @gutenberg/core run format && pnpm --filter @gutenberg/db run format && pnpm --filter @gutenberg/shared run format && pnpm --filter @gutenberg/gateway run format && pnpm --filter @gutenberg/api run format && pnpm --filter @gutenberg/indexer run format",
    "lint": "pnpm --filter @gutenberg/core run lint && pnpm --filter @gutenberg/db run lint && pnpm --filter @gutenberg/shared run lint && pnpm --filter @gutenberg/gateway run lint && pnpm --filter @gutenberg/api run lint && pnpm --filter @gutenberg/indexer run lint"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.6.0",
    "eslint": "10.2.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.3",
    "typescript": "5",
    "typescript-eslint": "8.59.1"
  }
}
