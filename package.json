{
  "name": "gutenberg",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.28.2 <11.0.0"
  },
  "scripts": {
    "docker:up": "docker compose up -d",
    "solana:validator": "solana-test-validator",
    "solana:airdrop": "pnpm run cli:start airdrop",
    "solana:build": "pnpm --filter @gutenberg/solana run anchor:build",
    "solana:deploy": "pnpm --filter @gutenberg/solana run anchor:deploy",
    "cli:build": "pnpm --filter @gutenberg/cli run build",
    "cli:format": "pnpm --filter @gutenberg/cli run format",
    "cli:lint": "pnpm --filter @gutenberg/cli run lint",
    "cli:start": "pnpm --filter @gutenberg/cli run gutenberg"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.6.0",
    "eslint": "10.2.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.3",
    "typescript": "^5",
    "typescript-eslint": "8.59.1"
  }
}
