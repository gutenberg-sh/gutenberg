{
  "name": "gutenberg",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonmeka/gutenberg.git"
  },
  "homepage": "https://github.com/leonmeka/gutenberg#readme",
  "bugs": {
    "url": "https://github.com/leonmeka/gutenberg/issues"
  },
  "packageManager": "pnpm@10.33.1",
  "type": "module",
  "engines": {
    "node": "22.22.2",
    "pnpm": "10.33.1"
  },
  "scripts": {
    "stack:up": "docker compose --profile app up -d --build --wait",
    "stack:up:local": "docker compose --profile app --profile local-chain up -d --build --wait",
    "stack:prepare": "docker compose up -d --wait && pnpm indexer:db:apply",
    "stack:down": "docker compose down",
    "stack:reset": "docker compose down -v",
    "solana:build": "pnpm --filter @gutenberg/solana run anchor:build",
    "solana:deploy": "pnpm --filter @gutenberg/solana run anchor:deploy",
    "solana:test": "pnpm --filter @gutenberg/solana run anchor:test",
    "core:build": "pnpm --filter @gutenberg/core run build",
    "core:format": "pnpm --filter @gutenberg/core run format",
    "core:lint": "pnpm --filter @gutenberg/core run lint",
    "gateway:dev": "pnpm --filter @gutenberg/gateway run dev",
    "gateway:build": "pnpm --filter @gutenberg/gateway run build",
    "gateway:preview": "pnpm --filter @gutenberg/gateway run preview",
    "gateway:format": "pnpm --filter @gutenberg/gateway run format",
    "gateway:lint": "pnpm --filter @gutenberg/gateway run lint",
    "indexer:db:migrate": "pnpm --filter @gutenberg/indexer run db:migrate",
    "indexer:db:apply": "pnpm --filter @gutenberg/indexer run db:apply",
    "indexer:dev": "pnpm --filter @gutenberg/indexer run dev",
    "indexer:build": "pnpm --filter @gutenberg/indexer run build",
    "indexer:start": "pnpm --filter @gutenberg/indexer run start",
    "indexer:format": "pnpm --filter @gutenberg/indexer run format",
    "indexer:lint": "pnpm --filter @gutenberg/indexer run lint",
    "format": "pnpm --filter @gutenberg/core run format && pnpm --filter @gutenberg/gateway run format && pnpm --filter @gutenberg/indexer run format",
    "lint": "pnpm --filter @gutenberg/core run lint && pnpm --filter @gutenberg/gateway run lint && pnpm --filter @gutenberg/indexer run lint"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.6.0",
    "eslint": "10.2.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.3",
    "typescript": "5",
    "typescript-eslint": "8.59.1"
  }
}
