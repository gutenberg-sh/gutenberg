# =============================================================================
# Gateway
# =============================================================================
VITE_GUTENBERG_SOLANA_RPC_URL=http://127.0.0.1:8899
VITE_GUTENBERG_IRYS_GATEWAY=https://devnet.irys.xyz
VITE_GUTENBERG_IRYS_NETWORK=devnet
VITE_GUTENBERG_ARWEAVE_MIRRORS=https://arweave.net,https://ar-io.dev,https://g8way.io,https://permagate.io
VITE_GUTENBERG_EXPLORER_URL=https://explorer.solana.com/address/{address}?cluster=http://127.0.0.1:8899
VITE_GUTENBERG_INDEXER_URL=http://127.0.0.1:4000

# =============================================================================
# Indexer
# =============================================================================
GUTENBERG_INDEXER_NODE_ENV=development
GUTENBERG_INDEXER_PORT=4000
GUTENBERG_INDEXER_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/gutenberg
GUTENBERG_INDEXER_SOLANA_RPC_URL=http://127.0.0.1:8899
GUTENBERG_INDEXER_SOLANA_WS_URL=ws://127.0.0.1:8900
GUTENBERG_INDEXER_BACKFILL_BATCH_SIZE=1000
GUTENBERG_INDEXER_BACKFILL_TX_CONCURRENCY=5
GUTENBERG_INDEXER_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# Docker Compose
# =============================================================================
GUTENBERG_POSTGRES_DB=gutenberg
GUTENBERG_POSTGRES_USER=postgres
GUTENBERG_POSTGRES_PASSWORD=postgres
GUTENBERG_POSTGRES_PORT=5432
GUTENBERG_SOLANA_RPC_PORT=8899
GUTENBERG_SOLANA_WS_PORT=8900
GUTENBERG_GATEWAY_PORT=8080
