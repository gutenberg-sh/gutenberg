{
  "name": "@gutenberg/indexer",
  "type": "commonjs",
  "scripts": {
    "predev": "pnpm --filter @gutenberg/core run build",
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @gutenberg/core run build",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "db:migrate": "drizzle-kit generate",
    "db:apply": "drizzle-kit migrate",
    "format": "eslint . --fix --ignore-pattern 'dist/**' --ignore-pattern '*.json' && prettier --write .",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@gutenberg/core": "workspace:*",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "nanoid": "^5.1.11",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
