    "@radix-ui/react-slot": "^1.2.0",
    "@solana-program/system": "~0.10.0",
    "@solana/addresses": "^5.5.1",
    "@solana/client": "1.7.0",
    "@solana/compat": "^5.5.1",
    "@solana/kit": "^5.5.1",
    "@solana/react-hooks": "1.4.1",
    "@solana/transactions": "^5.5.1",
    "@solana/web3.js": "^1.98.4",
