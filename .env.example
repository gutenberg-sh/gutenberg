# CLI

# User-configured trust mirrors for read-side resolution. Tried in order
# with fallback so a single gateway operator cannot censor reads. The CLI
# automatically appends the matching Irys gateway based on
# GUTENBERG_IRYS_NETWORK below — you do NOT need to add it here.
GUTENBERG_ARWEAVE_GATEWAYS=https://arweave.net,https://ar-io.dev,https://g8way.io,https://permagate.io
GUTENBERG_IRYS_NETWORK=devnet
GUTENBERG_SOLANA_RPC_URL=http://127.0.0.1:8899
GUTENBERG_GATEWAY_URL=http://localhost:5173
GUTENBERG_SOLANA_PRIVATE_KEY=<base58-encoded-solana-secret-key>

# Gateway

# The browser cannot derive a settlement mirror automatically (no concept
# of which bundler wrote the data) — include the Irys network gateway
# matching GUTENBERG_IRYS_NETWORK so the gateway can resolve content the
# CLI just published. For mainnet, use https://gateway.irys.xyz.
VITE_GUTENBERG_REGISTRY_PROGRAM_ID=NRrK71RxAHpt5CdLUWgRzTuzMopnRBnEqCiCku6J517
VITE_GUTENBERG_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VITE_GUTENBERG_ARWEAVE_GATEWAYS=https://arweave.net,https://ar-io.dev,https://g8way.io,https://permagate.io,https://devnet.irys.xyz
VITE_GUTENBERG_EXPLORER_URL=https://explorer.solana.com/address/{address}?cluster=http://127.0.0.1:8899
