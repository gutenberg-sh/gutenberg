# =============================================================================
# CLI
# =============================================================================

GUTENBERG_IRYS_NETWORK=devnet
GUTENBERG_SOLANA_RPC_URL=http://127.0.0.1:8899
GUTENBERG_GATEWAY_URL=http://localhost:5173

# =============================================================================
# Gateway
# =============================================================================

VITE_GUTENBERG_REGISTRY_PROGRAM_ID=NRrK71RxAHpt5CdLUWgRzTuzMopnRBnEqCiCku6J517
VITE_GUTENBERG_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VITE_GUTENBERG_IRYS_GATEWAY=https://devnet.irys.xyz
VITE_GUTENBERG_ARWEAVE_MIRRORS=https://arweave.net,https://ar-io.dev,https://g8way.io,https://permagate.io
VITE_GUTENBERG_EXPLORER_URL=https://explorer.solana.com/address/{address}?cluster=http://127.0.0.1:8899

# =============================================================================
# Indexer
# =============================================================================

GUTENBERG_INDEXER_NODE_ENV=development
GUTENBERG_INDEXER_PORT=4000
GUTENBERG_INDEXER_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/gutenberg_indexer
GUTENBERG_INDEXER_SOLANA_RPC_URL=http://127.0.0.1:8899
# Optional: defaults to ws(s):// of the RPC URL above
# GUTENBERG_INDEXER_SOLANA_WS_URL=ws://127.0.0.1:8900
GUTENBERG_INDEXER_PROGRAM_ID=NRrK71RxAHpt5CdLUWgRzTuzMopnRBnEqCiCku6J517
GUTENBERG_INDEXER_BACKFILL_BATCH_SIZE=1000
GUTENBERG_INDEXER_BACKFILL_TX_CONCURRENCY=5
GUTENBERG_INDEXER_RECONCILE_LOOKBACK_SLOTS=5000
# Comma-separated list; leave empty in dev to allow any origin
# GUTENBERG_INDEXER_CORS_ORIGINS=http://localhost:5173
